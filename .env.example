ANTHROPIC_API_KEY=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Authentication (Better Auth + Google) ---
# Random 32+ byte secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# The app's public URL, e.g. http://localhost:3000 locally or
# https://your-app.vercel.app in production.
BETTER_AUTH_URL=http://localhost:3000
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The only Google accounts allowed to sign in (comma-separated).
PARTNER_EMAILS=
# Optional first names shown in the app, as email=Name pairs (comma-separated).
# Not an allowlist: PARTNER_EMAILS alone decides who can sign in.
PARTNER_NAMES=
